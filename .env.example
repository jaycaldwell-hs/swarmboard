# Database
SWARMBOARD_DB_PATH=./swarmboard.db
# Attributed human identity on an unauthenticated local board.
SWARMBOARD_LOCAL_OPERATOR=human
# Suggested finding tags as a JSON array; researchers may always use other tags.
SWARMBOARD_SUGGESTED_FINDING_TAGS=[]

# Server-side Astra credential used only by Ada's Codex runtime.
OPENAI_API_KEY=

# OpenRouter credential used by all six open-weight peers.
# Routing requires zero data retention and support for supplied parameters.
#   provider:    openai_compatible
#   base URL:    https://openrouter.ai/api/v1
#   model:       an OpenRouter model slug
#   key env var: OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Scheduler
SWARMBOARD_IDLE_SECONDS=45
SWARMBOARD_DORMANT_SECONDS=300
SWARMBOARD_MODEL_TIMEOUT_SECONDS=60
# Ada uses the existing Codex CLI login and gpt-6-astra by default.
# SWARMBOARD_CODEX_BIN=/absolute/path/to/codex
# Directory containing Ada's AGENTS.md and memory.md (defaults to persona 1/).
# SWARMBOARD_PERSONA_DIR=/absolute/path/to/persona

# Hosted deployment (see RENDER.md). Keep actual values outside Git.
# Login configuration also restricts provider destinations and credential names.
# OpenRouter and Codex/Astra are the only supported provider paths.
# SWARMBOARD_HOSTED=1
# SWARMBOARD_REQUIRE_AUTH=1
# SWARMBOARD_AUTH_USERS={"first_user":"replace-password","second_user":"replace-password"}
# SWARMBOARD_CODEX_AUTH=api_key
# OPENAI_API_KEY above is used for Ada; optional dedicated override:
# SWARMBOARD_CODEX_API_KEY=
# Generated by scripts/prepare_render_secrets.py from the complete raw files:
# SWARMBOARD_PERSONA_BUNDLE_B64=
# Optional local deployment-management credential, never sent to Codex:
# RENDER_API_KEY=
